{
  "$schema": "appsettings-schema.json",

  "ConnectionStrings": {
    "umbracoDbDSN": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=true;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },

  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "GENERATE_A_UNIQUE_GUID_FOR_THIS_ENVIRONMENT"
      },
      "Imaging": {
        "HMACSecretKey": "GENERATE_A_UNIQUE_SECRET_FOR_THIS_ENVIRONMENT"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://your-domain.example/"
      }
    }
  },

  "Site": {
    "PublicBaseUrl": "https://your-domain.example/"
  },

  "ReverseProxy": {
    "Routes": {
      "crm-route": {
        "ClusterId": "crm-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "crm-cluster": {
        "Destinations": {
          "crm-destination": {
            "Address": "http://CRM_INTERNAL_HOST:PORT/"
          }
        }
      }
    }
  },

  "Crm": {
    "InternalBaseUrl": "http://CRM_INTERNAL_HOST:PORT",
    "LoginPath": "/api/users/login",
    "GatewayHosts": ["your-domain.example"],
    "GatewayPorts": [443],
    "LogoutRedirectUrl": "https://your-domain.example/",
    "TimeZoneId": "Iran Standard Time"
  },

  "ConsultRequests": {
    "ResumeStoragePath": "C:\\AppData\\DrsUmbraco\\Resumes",
    "AllowedBackofficeGroupKeys": [
      "PUT_A_REAL_UMBRACO_BACKOFFICE_GROUP_GUID_HERE"
    ]
  },

  "Chatbot": {
    "SemanticDecision": {
      "MinimumScore": 0.88,
      "MinimumMargin": 0.05
    },
    "NoMatchDecision": {
      "MinimumSemanticScore": 0.875
    },
    "RelevanceVerifier": {
      "ModelPath": "AIModel/bge-reranker-v2-m3/model.onnx",
      "TokenizerPath": "AIModel/bge-reranker-v2-m3/sentencepiece.bpe.model",
      "Threshold": -2.777814
    }
  },

  "Features": {
    "Chatbot": {
      "Enabled": false
    }
  }
}
