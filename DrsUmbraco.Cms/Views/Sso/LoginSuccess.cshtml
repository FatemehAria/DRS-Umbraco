@using System.Text.Json
@model DrsUmbraco.Cms.Models.Sso.LoginSuccessViewModel

@{
    Layout = "_PortalLayout";

    ViewData["Title"] = "در حال ورود";
    ViewData["BodyClass"] = "portal-redirect-page";

    var serializedResponseBody =
    JsonSerializer.Serialize(Model.ResponseBody);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/portal-redirect.css" asp-append-version="true" />
}

<main class="portal-redirect" role="status" aria-live="polite">

    <div class="portal-redirect__spinner" aria-hidden="true">
    </div>

    <span class="visually-hidden">
        در حال ورود به سامانه، لطفاً صبر کنید.
    </span>
</main>

@section Scripts {
    <script>
        const responseText =
                                        @Html.Raw(serializedResponseBody);

        const loginData =
            JSON.parse(responseText);

        try {
            const configItems =
                JSON.parse(loginData.config || "[]");

            for (const item of configItems) {
                const name =
                    (item.ParamName || "").toLowerCase();

                if (
                    name === "apiaddress" ||
                    name === "baseaddress"
                ) {
                    item.ParamValue = "/api/";
                }

                if (name === "filesimulate") {
                    item.ParamValue =
                        "/api/misc/filesimulate";
                }
            }

            loginData.config =
                JSON.stringify(configItems);
        } catch (error) {
            console.error(error);
        }

        localStorage.setItem(
            "loginSystemName",
            loginData.systemName || "sama"
        );

        localStorage.setItem(
            "sama-token",
            JSON.stringify(loginData)
        );

        window.location.replace("/dashboard");
    </script>
}