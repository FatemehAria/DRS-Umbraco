@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions

@{
    Layout = null;

    var pageTitle = Model.Value<string>("pageTitle") ?? "دیدگاه رایانه سما";

    var latestNewsItems = Umbraco.ContentAtRoot()
    .SelectMany(x => x.DescendantsOrSelf())
    .Where(x => x.ContentType.Alias == "newsArticle")
    .OrderByDescending(x => x.Value<DateTime?>("publishDate") ?? x.CreateDate)
    .Take(3)
    .ToList();
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@pageTitle</title>

    <link rel="stylesheet" href="/css/sama.css" />
</head>

<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" href="/" aria-label="دیدگاه رایانه سما">
                <img src="/assets/sama/uploads/2024/11/لوگو_ی_شرکت-removebg-preview.png" alt="دیدگاه رایانه سما" />
            </a>

            <nav class="main-nav" aria-label="منوی اصلی">
                <a href="/products">محصولات</a>
                <a href="/recruitment">فرصت های شغلی</a>
                <a href="/contact-us">تماس با ما</a>
                <a href="/about-us">درباره ما</a>
            </nav>

            <div class="header-phone">
                <span>☎</span>
                <strong>۰۲۱-۸۸۳۳۴۱۱۷</strong>
            </div>
        </div>
    </header>

    <main>
        <!-- Hero -->
        <section class="hero-slider hero-showcase" data-slider>
            <div class="hero-slide is-active" style="background-image:url('/assets/sama/uploads/2024/11/slider-1.jpg')"></div>
            <div class="hero-slide" style="background-image:url('/assets/sama/uploads/2024/11/slider2.jpg')"></div>
            <div class="hero-slide" style="background-image:url('/assets/sama/uploads/2024/11/slider3.jpg')"></div>

            <div class="hero-overlay"></div>

            <div class="container hero-content">
                <span class="hero-eyebrow">دیدگاه رایانه سما</span>

                <h1>
                    راهکارهای نرم‌افزاری یکپارچه
                    <br />
                    برای سازمان‌های حرفه‌ای
                </h1>

                <p>
                    طراحی و توسعه سامانه‌های سازمانی در حوزه مالی، منابع انسانی، فروش، درآمد و فرایندهای اداری
                    با تمرکز بر پایداری، پشتیبانی و تجربه کاربری بهتر.
                </p>

                <div class="hero-actions">
                    <a class="ui-btn ui-btn-primary" href="#demo-form">درخواست دمو یا مشاوره</a>
                    <a class="ui-btn ui-btn-outline" href="/products">مشاهده محصولات</a>
                </div>

                <div class="hero-stats" aria-label="آمار شرکت">
                    <div>
                        <strong>۳۰+</strong>
                        <span>سال تجربه</span>
                    </div>

                    <div>
                        <strong>سازمانی</strong>
                        <span>راهکارهای یکپارچه</span>
                    </div>

                    <div>
                        <strong>پشتیبانی</strong>
                        <span>همراه مشتریان</span>
                    </div>
                </div>
            </div>

            <button class="slider-arrow prev" type="button" data-prev aria-label="اسلاید قبلی">‹</button>
            <button class="slider-arrow next" type="button" data-next aria-label="اسلاید بعدی">›</button>

            <div class="slider-dots" data-dots>
                <button type="button" class="is-active" aria-label="اسلاید ۱"></button>
                <button type="button" aria-label="اسلاید ۲"></button>
                <button type="button" aria-label="اسلاید ۳"></button>
            </div>
        </section>

        <!-- Capabilities -->
        <section class="container capability-section reveal-section">
            <div class="capability-grid">
                <article class="capability-card">
                    <span class="capability-number">01</span>

                    <div class="capability-icon">
                        <img src="/assets/sama/uploads/2024/11/support.svg" alt="" />
                    </div>

                    <h2>پشتیبانی سازمانی</h2>
                    <p>همراهی فنی و پاسخ‌گویی برای حفظ پایداری سیستم‌ها و کاهش اختلال در فرایندهای کاری.</p>
                </article>

                <article class="capability-card">
                    <span class="capability-number">02</span>

                    <div class="capability-icon">
                        <img src="/assets/sama/uploads/2024/11/chalkboard-teacher.svg" alt="" />
                    </div>

                    <h2>آموزش و استقرار</h2>
                    <p>کمک به کاربران برای استفاده بهتر از نرم‌افزارها و کاهش مقاومت سازمانی در زمان استقرار.</p>
                </article>

                <article class="capability-card">
                    <span class="capability-number">03</span>

                    <div class="capability-icon">
                        <img src="/assets/sama/uploads/2024/11/idea-sharing.svg" alt="" />
                    </div>

                    <h2>مشاوره فرایندی</h2>
                    <p>تحلیل نیاز سازمان و پیشنهاد راهکار مناسب برای ساده‌تر شدن گردش کارها و تصمیم‌گیری‌ها.</p>
                </article>
            </div>
        </section>

        <!-- Clients -->
        <section class="clients-section reveal-section">
            <div class="container">
                <div class="section-heading">
                    <span>مورد اعتماد سازمان‌ها</span>
                    <h2>۳۰ سال تجربه در کنار مشتریان سازمانی</h2>
                    <p>نمونه‌ای از سازمان‌ها و مجموعه‌هایی که از راهکارهای نرم‌افزاری سما استفاده کرده‌اند.</p>
                </div>
            </div>

            <div class="logo-carousel" aria-label="لوگوی مشتریان">
                <div class="logo-track">
                    <div class="logo-item">
                        <img src="/assets/sama/uploads/2024/11/Ikco_brand-removebg-preview.png" alt="ایران خودرو" />
                    </div>

                    <div class="logo-item">
                        <img src="/assets/sama/uploads/2024/11/Kashan-removebg-preview.png" alt="شهرداری کاشان" />
                    </div>

                    <div class="logo-item">
                        <img src="/assets/sama/uploads/2024/11/Shahrdari_Gorgan-removebg-preview.png" alt="شهرداری گرگان" />
                    </div>

                    <div class="logo-item">
                        <img src="/assets/sama/uploads/2024/11/Urmia.Municipality.Logo-removebg-preview.png" alt="شهرداری ارومیه" />
                    </div>

                    <!-- Duplicate logos for continuous carousel loop -->
                    <div class="logo-item" aria-hidden="true">
                        <img src="/assets/sama/uploads/2024/11/Ikco_brand-removebg-preview.png" alt="" />
                    </div>

                    <div class="logo-item" aria-hidden="true">
                        <img src="/assets/sama/uploads/2024/11/Kashan-removebg-preview.png" alt="" />
                    </div>

                    <div class="logo-item" aria-hidden="true">
                        <img src="/assets/sama/uploads/2024/11/Shahrdari_Gorgan-removebg-preview.png" alt="" />
                    </div>

                    <div class="logo-item" aria-hidden="true">
                        <img src="/assets/sama/uploads/2024/11/Urmia.Municipality.Logo-removebg-preview.png" alt="" />
                    </div>
                </div>
            </div>
        </section>

        <!-- Products -->
        <section class="container products-section reveal-section">
            <div class="section-heading">
                <span>محصولات</span>
                <h2>راهکارهای نرم‌افزاری برای نیازهای سازمانی</h2>
                <p>محصولات سما برای پوشش فرایندهای کلیدی سازمان‌ها طراحی شده‌اند.</p>
            </div>

            <div class="product-grid product-grid-polished">
                <a class="product-card product-card-polished" href="/financials-system">
                    <div class="product-icon">
                        <img src="/assets/sama/uploads/2024/11/finance-2.svg" alt="" />
                    </div>

                    <h3>حوزه مالی و حسابداری</h3>
                    <p>راهکارهایی برای مدیریت مالی، حسابداری، گزارش‌گیری و کنترل فرایندهای مالی سازمان.</p>
                    <span>مشاهده جزئیات</span>
                </a>

                <a class="product-card product-card-polished is-featured" href="/sales-and-revenue">
                    <div class="product-icon">
                        <img src="/assets/sama/uploads/2024/11/income-1-2.svg" alt="" />
                    </div>

                    <h3>حوزه فروش و درآمد</h3>
                    <p>مدیریت فرایندهای فروش، درآمد، صدور اسناد و تحلیل اطلاعات عملیاتی.</p>
                    <span>مشاهده جزئیات</span>
                </a>

                <a class="product-card product-card-polished" href="/human-resource-system">
                    <div class="product-icon">
                        <img src="/assets/sama/uploads/2024/11/hr.svg" alt="" />
                    </div>

                    <h3>حوزه منابع انسانی</h3>
                    <p>پشتیبانی از فرایندهای منابع انسانی، اطلاعات پرسنلی و گردش‌های اداری سازمان.</p>
                    <span>مشاهده جزئیات</span>
                </a>
            </div>
        </section>

        <!-- News -->
        <section class="container news-section-polished reveal-section">
            <div class="section-heading">
                <span>اخبار و مقالات</span>
                <h2>آخرین رویدادها و مطالب سازمانی</h2>
                <p>نگاهی به اخبار، مقاله‌ها و تازه‌ترین محتوای منتشرشده در حوزه نرم‌افزارهای سازمانی.</p>
            </div>

            @if (latestNewsItems?.Any() == true)
            {
                <div class="news-grid news-grid-premium">
                    @foreach (var item in latestNewsItems)
                    {
                        var title = item.Value<string>("title");
                        if (string.IsNullOrWhiteSpace(title))
                        {
                            title = item.Name;
                        }

                        var summary = item.Value<string>("summary");
                        var publishDate = item.Value<DateTime?>("publishDate");
                        var coverImage = item.Value<MediaWithCrops>("coverImage");

                        <article class="news-card news-card-premium">
                            <a href="@item.Url()" class="news-image-link">
                                @if (coverImage != null)
                                {
                                    <img src="@coverImage.MediaUrl()" alt="@title" />
                                }
                                else
                                {
                                    <img src="/assets/sama/uploads/2024/11/1.jpg" alt="@title" />
                                }
                            </a>

                            <div class="news-card-body">
                                <span class="news-meta">
                                    @(publishDate.HasValue ? publishDate.Value.ToString("yyyy/MM/dd") : "اخبار")
                                </span>

                                <h3>@title</h3>

                                @if (!string.IsNullOrWhiteSpace(summary))
                                {
                                    <p>@summary</p>
                                }

                                <a href="@item.Url()" class="news-read-more">مشاهده خبر</a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="news-empty-state">
                    <h2>هنوز خبری منتشر نشده است</h2>
                    <p>بعد از انتشار خبرها در Umbraco، آخرین اخبار در صفحه اصلی نمایش داده می‌شوند.</p>
                </div>
            }
        </section>

        <!-- Testimonials -->
        <section class="testimonial-section reveal-section" data-testimonials>
            <div class="container">
                <div class="section-heading">
                    <span>بازخورد مشتریان</span>
                    <h2>چرا سازمان‌ها سما را انتخاب می‌کنند؟</h2>
                    <p>نمونه‌ای از تجربه مشتریان در استفاده از راهکارهای نرم‌افزاری سازمانی.</p>
                </div>

                <div class="testimonial-shell">
                    <button class="testimonial-nav testimonial-prev" type="button" data-testimonial-prev aria-label="نظر قبلی">‹</button>

                    <div class="testimonial-slider">
                        <article class="testimonial-slide is-active">
                            <div class="quote-mark">”</div>

                            <p>
                                استفاده از سامانه‌های سما باعث شد بخشی از فرایندهای داخلی ما ساختارمندتر و قابل پیگیری‌تر شود.
                            </p>

                            <div class="testimonial-person">
                                <img src="/assets/sama/uploads/2024/11/portrait-smiling-caucasian-senior-businessman.jpg" alt="مدیر سازمانی" />

                                <div>
                                    <strong>مدیر مالی</strong>
                                    <span>مشتری سازمانی</span>
                                </div>
                            </div>
                        </article>

                        <article class="testimonial-slide">
                            <div class="quote-mark">”</div>

                            <p>
                                پشتیبانی و همراهی تیم فنی برای ما مهم بود. امکان دریافت مشاوره و پیگیری سریع، تجربه خوبی ایجاد کرد.
                            </p>

                            <div class="testimonial-person">
                                <img src="/assets/sama/uploads/2024/11/portrait-smiling-caucasian-senior-businessman.jpg" alt="مدیر فناوری اطلاعات" />

                                <div>
                                    <strong>مدیر فناوری اطلاعات</strong>
                                    <span>مشتری سازمانی</span>
                                </div>
                            </div>
                        </article>

                        <article class="testimonial-slide">
                            <div class="quote-mark">”</div>

                            <p>
                                نرم‌افزارهای سازمانی زمانی ارزشمند هستند که هم پایدار باشند و هم کاربران بتوانند راحت با آن‌ها کار کنند.
                            </p>

                            <div class="testimonial-person">
                                <img src="/assets/sama/uploads/2024/11/portrait-smiling-caucasian-senior-businessman.jpg" alt="مدیر منابع انسانی" />

                                <div>
                                    <strong>مدیر منابع انسانی</strong>
                                    <span>مشتری سازمانی</span>
                                </div>
                            </div>
                        </article>
                    </div>

                    <button class="testimonial-nav testimonial-next" type="button" data-testimonial-next aria-label="نظر بعدی">›</button>
                </div>

                <div class="testimonial-dots" data-testimonial-dots>
                    <button type="button" class="is-active" aria-label="نظر ۱"></button>
                    <button type="button" aria-label="نظر ۲"></button>
                    <button type="button" aria-label="نظر ۳"></button>
                </div>
            </div>
        </section>

        <!-- Demo Request Form -->
        <section id="demo-form" class="container demo-section reveal-section">
            <div class="demo-text">
                <span class="demo-badge">شروع همکاری</span>

                <h2>درخواست دمو یا مشاوره</h2>

                <p>
                    برای بررسی نیازهای سازمان، دریافت مشاوره یا مشاهده دمو، فرم را تکمیل کنید.
                    کارشناسان ما پس از بررسی درخواست با شما تماس می‌گیرند.
                </p>

                <div class="demo-benefits">
                    <span>✓ بررسی نیاز سازمان</span>
                    <span>✓ معرفی راهکار مناسب</span>
                    <span>✓ پیگیری توسط تیم پشتیبانی</span>
                </div>
            </div>

            <form id="consultRequestForm" class="demo-form sama-consult-form">
                <div class="form-row">
                    <label>
                        نام و نام خانوادگی
                        <input type="text" placeholder="مثلاً: فاطمه کریمی" name="fullName" required />
                    </label>

                    <label>
                        شماره تماس
                        <input type="tel" placeholder="مثلاً: 09120000000" name="mobile" required />
                    </label>
                </div>

                <label>
                    نوع درخواست
                    <select name="requestType" required>
                        <option value="دمو">درخواست دمو</option>
                        <option value="مشاوره">درخواست مشاوره</option>
                    </select>
                </label>

                <label>
                    توضیحات
                    <textarea name="message" placeholder="نیاز یا سوال خود را کوتاه بنویسید..."></textarea>
                </label>

                <button type="submit" data-submit-text="ثبت درخواست مشاوره">
                    ثبت درخواست مشاوره
                </button>

                <div id="consultRequestMessage"></div>
            </form>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <h3>دسترسی سریع</h3>

                <a href="/recruitment">فرصت های شغلی</a>
                <a href="/contact-us">تماس با ما</a>
                <a href="/about-us">درباره ما</a>
                <a href="/products">محصولات</a>
            </div>

            <div>
                <h3>تماس با ما</h3>

                <p>آدرس: خیابان کارگر شمالی بالاتر از پمپ بنزین پلاک ۲۵۱</p>
                <p>تلفن: ۰۲۱-۸۸۳۳۴۱۱۷</p>
            </div>

            <div>
                <h3>نمادها و مجوزها</h3>

                <div class="footer-logos">
                    <img src="/assets/sama/uploads/2024/11/logo-right-inv4.png" alt="مجوز" />
                    <img src="/assets/sama/uploads/2024/11/شورای-عالی-انفورماتیک-removebg-preview.png" alt="شورای عالی انفورماتیک" />
                </div>
            </div>
        </div>

        <p class="copyright">
            کلیه حقوق مادی و معنوی این سایت متعلق به شرکت دیدگاه رایانه سما می باشد.
        </p>
    </footer>

    <button class="back-to-top" type="button" data-back-to-top aria-label="بازگشت به بالا">⌃</button>

    <script src="/js/sama.js"></script>
</body>
</html>