@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.PublishedContent

@{
    
    Layout = "Master.cshtml";

    var showHero = Model.Value<bool?>("showHero") ?? true;

    var pageTitle = Model.Value<string>("pageTitle") ?? "دیدگاه رایانه سما";
    ViewData["PageTitle"] = pageTitle;

    MediaWithCrops? FirstMedia(IPublishedContent content, string alias)
    {
        var singleImage = content.Value<MediaWithCrops>(alias);

        if (singleImage != null)
        {
            return singleImage;
        }

        var multipleImages = content.Value<IEnumerable<MediaWithCrops>>(alias);

        return multipleImages?.FirstOrDefault();
    }

    var selectedHeroImages = Model
        .Value<IEnumerable<MediaWithCrops>>("heroImages")?
        .Where(image => image != null)
        .Select(image => image.MediaUrl())
        .Where(url => !string.IsNullOrWhiteSpace(url))
        .ToList();

    var heroImageUrls = selectedHeroImages?.Any() == true
        ? selectedHeroImages
        : new List<string>
        {
            "/assets/sama/uploads/2024/11/hero-office-automation-dashboard.png",
            "/assets/sama/uploads/2024/11/hero-workflow-demo-meeting.png",
            "/assets/sama/uploads/2024/11/hero-digital-document-flow.png"
        };
    
    string TextOrDefault(string alias, string fallback)
    {
        var value = Model.Value<string>(alias);

        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim();
    }

    int NumberOrDefault(string alias, int fallback, int min, int max)
    {
        var value = Model.Value<int?>(alias);

        if (!value.HasValue)
        {
            return fallback;
        }

        return Math.Clamp(value.Value, min, max);
    }

    var showProductsSection = Model.Value<bool?>("showProductsSection") ?? true;
    var productsSectionLabel = TextOrDefault("productsSectionLabel", "محصولات");
    var productsSectionTitle = TextOrDefault("productsSectionTitle", "راهکارهای نرم‌افزاری برای نیازهای سازمانی");
    var productsSectionDescription = TextOrDefault("productsSectionDescription", "محصولات سما برای پوشش فرایندهای کلیدی سازمان‌ها طراحی شده‌اند.");
    var productsSectionItemCount = NumberOrDefault("productsSectionItemCount", 3, 1, 12);

    var showNewsSection = Model.Value<bool?>("showNewsSection") ?? true;
    var newsSectionLabel = TextOrDefault("newsSectionLabel", "اخبار و مقالات");
    var newsSectionTitle = TextOrDefault("newsSectionTitle", "آخرین رویدادها و مطالب سازمانی");
    var newsSectionDescription = TextOrDefault("newsSectionDescription", "نگاهی به اخبار، مقاله‌ها و تازه‌ترین محتوای منتشرشده در حوزه نرم‌افزارهای سازمانی.");
    var newsSectionItemCount = NumberOrDefault("newsSectionItemCount", 3, 1, 12);

    var latestNewsItems = Umbraco.ContentAtRoot()
        .SelectMany(x => x.DescendantsOrSelf())
        .Where(x => x.ContentType.Alias == "newsArticle")
        .OrderByDescending(x => x.Value<DateTime?>("publishDate") ?? x.CreateDate)
        .Take(newsSectionItemCount)
        .ToList();

    var homeProducts = Umbraco.ContentAtRoot()
        .SelectMany(x => x.DescendantsOrSelf())
        .Where(x => x.ContentType.Alias == "productItem")
        .OrderBy(x => x.SortOrder)
        .Take(productsSectionItemCount)
        .ToList();

    var clientLogos = new[]
    {
        new
        {
            Src = "/assets/sama/uploads/2024/11/Ikco_brand-removebg-preview.png",
            Alt = "ایران خودرو"
        },
        new
        {
            Src = "/assets/sama/uploads/2024/11/Kashan-removebg-preview.png",
            Alt = "شهرداری کاشان"
        },
        new
        {
            Src = "/assets/sama/uploads/2024/11/Shahrdari_Gorgan-removebg-preview.png",
            Alt = "شهرداری گرگان"
        },
        new
        {
            Src = "/assets/sama/uploads/2024/11/Urmia.Municipality.Logo-removebg-preview.png",
            Alt = "شهرداری ارومیه"
        }
    };

    var heroTitleLine1 = TextOrDefault("heroTitleLine1", "راهکارهای نرم‌افزاری یکپارچه");
    var heroTitleLine2 = TextOrDefault("heroTitleLine2", "برای سازمان‌های حرفه‌ای");

    var heroDescription = TextOrDefault(
        "heroDescription",
        "طراحی و توسعه سامانه‌های سازمانی در حوزه مالی، منابع انسانی، فروش، درآمد و فرایندهای اداری با تمرکز بر پایداری، پشتیبانی و تجربه کاربری بهتر."
    );

    var heroPrimaryButtonText = TextOrDefault("heroPrimaryButtonText", "درخواست دمو یا مشاوره");
    var heroPrimaryButtonUrl = TextOrDefault("heroPrimaryButtonUrl", "#demo-form");

    var heroSecondaryButtonText = TextOrDefault("heroSecondaryButtonText", "مشاهده محصولات");
    var heroSecondaryButtonUrl = TextOrDefault("heroSecondaryButtonUrl", "/products");

    var heroStats = new[]
    {
        new
        {
            Value = TextOrDefault("heroStat1Value", "۳۰+"),
            Label = TextOrDefault("heroStat1Label", "سال تجربه")
        },
        new
        {
            Value = TextOrDefault("heroStat2Value", "سازمانی"),
            Label = TextOrDefault("heroStat2Label", "راهکارهای یکپارچه")
        },
        new
        {
            Value = TextOrDefault("heroStat3Value", "پشتیبانی"),
            Label = TextOrDefault("heroStat3Label", "همراه مشتریان")
        }
    };
}


        <!-- Hero -->
        @if(showHero) {
            <section class="hero-slider hero-showcase" data-slider>
                @for (var i = 0; i < heroImageUrls.Count; i++)
                {
                    var slideClass = i == 0 ? "hero-slide is-active" : "hero-slide";

                    <div class="@slideClass"
                        style="background-image:url('@heroImageUrls[i]')">
                    </div>
                }

                <div class="hero-overlay"></div>

                <div class="container hero-content">
                    <h1>
                        @heroTitleLine1

                        @if (!string.IsNullOrWhiteSpace(heroTitleLine2))
                        {
                            <br />
                            @heroTitleLine2
                        }
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(heroDescription))
                    {
                        <p>@heroDescription</p>
                    }

                    <div class="hero-actions">
                        @if (!string.IsNullOrWhiteSpace(heroPrimaryButtonText) &&
                            !string.IsNullOrWhiteSpace(heroPrimaryButtonUrl))
                        {
                            <a class="ui-btn ui-btn-primary" href="@heroPrimaryButtonUrl">
                                @heroPrimaryButtonText
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(heroSecondaryButtonText) &&
                            !string.IsNullOrWhiteSpace(heroSecondaryButtonUrl))
                        {
                            <a class="ui-btn ui-btn-outline" href="@heroSecondaryButtonUrl">
                                @heroSecondaryButtonText
                            </a>
                        }
                    </div>

                    <div class="hero-stats" aria-label="آمار شرکت">
                        @foreach (var stat in heroStats)
                        {
                            if (!string.IsNullOrWhiteSpace(stat.Value) ||
                                !string.IsNullOrWhiteSpace(stat.Label))
                            {
                                <div>
                                    <strong>@stat.Value</strong>
                                    <span>@stat.Label</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                @if (heroImageUrls.Count > 1)
                {
                    <button class="slider-arrow prev" type="button" data-prev aria-label="اسلاید قبلی">‹</button>
                    <button class="slider-arrow next" type="button" data-next aria-label="اسلاید بعدی">›</button>
                }

                @if (heroImageUrls.Count > 1)
                {
                    <div class="slider-dots" data-dots>
                        @for (var i = 0; i < heroImageUrls.Count; i++)
                        {
                            var dotClass = i == 0 ? "is-active" : null;

                            <button type="button"
                                    class="@dotClass"
                                    aria-label="اسلاید @(i + 1)">
                            </button>
                        }
                    </div>
                }
            </section>
        }

        <!-- Capabilities -->
        <section class="container capability-section reveal-section">
            <div class="capability-grid">
                <article class="capability-card">
                    <span class="capability-number">01</span>

                    <div class="capability-icon">
                        <img src="/assets/sama/uploads/2024/11/support.svg" alt="" />
                    </div>

                    <h2>پشتیبانی سازمانی</h2>
                    <p>همراهی فنی و پاسخ‌گویی برای حفظ پایداری سیستم‌ها و کاهش اختلال در فرایندهای کاری.</p>
                </article>

                <article class="capability-card">
                    <span class="capability-number">02</span>

                    <div class="capability-icon">
                        <img src="/assets/sama/uploads/2024/11/chalkboard-teacher.svg" alt="" />
                    </div>

                    <h2>آموزش و استقرار</h2>
                    <p>کمک به کاربران برای استفاده بهتر از نرم‌افزارها و کاهش مقاومت سازمانی در زمان استقرار.</p>
                </article>

                <article class="capability-card">
                    <span class="capability-number">03</span>

                    <div class="capability-icon">
                        <img src="/assets/sama/uploads/2024/11/idea-sharing.svg" alt="" />
                    </div>

                    <h2>مشاوره فرایندی</h2>
                    <p>تحلیل نیاز سازمان و پیشنهاد راهکار مناسب برای ساده‌تر شدن گردش کارها و تصمیم‌گیری‌ها.</p>
                </article>
            </div>
        </section>

        <!-- Clients -->
        <section class="clients-section reveal-section">
            <div class="container">
                <div class="section-heading">
                    <span>مورد اعتماد سازمان‌ها</span>
                    <h2>۳۰ سال تجربه در کنار مشتریان سازمانی</h2>
                    <p>نمونه‌ای از سازمان‌ها و مجموعه‌هایی که از راهکارهای نرم‌افزاری سما استفاده کرده‌اند.</p>
                </div>
            </div>

            <div class="logo-carousel" aria-label="لوگوی مشتریان">
                <div class="logo-track">
                    @for (var group = 0; group < 2; group++)
                    {
                        <div class="logo-group" aria-hidden="@(group == 1 ? "true" : null)">
                            @for (var repeat = 0; repeat < 3; repeat++)
                            {
                                foreach (var logo in clientLogos)
                                {
                                    <div class="logo-item">
                                        <img
                                            src="@logo.Src"
                                            alt="@(group == 0 && repeat == 0 ? logo.Alt : "")" />
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Products -->
        @if (showProductsSection)
        {
            <section class="container products-section reveal-section">
                <div class="section-heading">
                    <span>@productsSectionLabel</span>
                    <h2>@productsSectionTitle</h2>

                    @if (!string.IsNullOrWhiteSpace(productsSectionDescription))
                    {
                        <p>@productsSectionDescription</p>
                    }
                </div>

                @if (homeProducts.Any())
                {
                    <div class="product-grid product-grid-polished">
                        @for (var i = 0; i < homeProducts.Count; i++)
                        {
                            var product = homeProducts[i];

                            var title = product.Value<string>("title");
                            if (string.IsNullOrWhiteSpace(title))
                            {
                                title = product.Name;
                            }

                            var summary = product.Value<string>("summary");
                            var icon = product.Value<MediaWithCrops>("icon");

                            var cardClass = "product-card product-card-polished";
                            if (i == 1)
                            {
                                cardClass += " is-featured";
                            }

                            <a class="@cardClass" href="@product.Url()">
                                <div class="product-icon">
                                    @if (icon != null)
                                    {
                                        <img src="@icon.MediaUrl()" alt="" />
                                    }
                                    else
                                    {
                                        <img src="/assets/sama/uploads/2024/11/finance-2.svg" alt="" />
                                    }
                                </div>

                                <h3>@title</h3>

                                @if (!string.IsNullOrWhiteSpace(summary))
                                {
                                    <p>@summary</p>
                                }

                                <span>مشاهده جزئیات</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="news-empty-state">
                        <h2>هنوز محصولی ثبت نشده است</h2>
                    </div>
                }
            </section>
        }

        <!-- News -->
        @if (showNewsSection)
        {
            <section class="container news-section-polished reveal-section">
                <div class="section-heading">
                    <span>@newsSectionLabel</span>
                    <h2>@newsSectionTitle</h2>

                    @if (!string.IsNullOrWhiteSpace(newsSectionDescription))
                    {
                        <p>@newsSectionDescription</p>
                    }
                </div>

                @if (latestNewsItems?.Any() == true)
                {
                    <div class="news-grid news-grid-premium">
                        @foreach (var item in latestNewsItems)
                        {
                            var title = item.Value<string>("title");
                            if (string.IsNullOrWhiteSpace(title))
                            {
                                title = item.Name;
                            }

                            var summary = item.Value<string>("summary");
                            var publishDate = item.Value<DateTime?>("publishDate");
                            var coverImage = FirstMedia(item, "coverImage");

                            <article class="news-card news-card-premium">
                                <a href="@item.Url()" class="news-image-link">
                                    @if (coverImage != null)
                                    {
                                        <img src="@coverImage.MediaUrl()" alt="@title" />
                                    }
                                    else
                                    {
                                        <img src="/assets/sama/uploads/2024/11/5565.jpg" alt="@title" />
                                    }
                                </a>

                                <div class="news-card-body">
                                    <span class="news-meta">
                                        @(publishDate.HasValue ? publishDate.Value.ToString("yyyy/MM/dd") : "اخبار")
                                    </span>

                                    <h3>@title</h3>

                                    @if (!string.IsNullOrWhiteSpace(summary))
                                    {
                                        <p>@summary</p>
                                    }

                                    <a href="@item.Url()" class="news-read-more">مشاهده خبر</a>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="news-empty-state">
                        <h2>هنوز خبری منتشر نشده است</h2>
                        <p>بعد از انتشار خبرها در Umbraco، آخرین اخبار در صفحه اصلی نمایش داده می‌شوند.</p>
                    </div>
                }
            </section>
        }

        <!-- Testimonials -->
        <section class="testimonial-section reveal-section" data-testimonials>
            <div class="container">
                <div class="section-heading">
                    <span>بازخورد مشتریان</span>
                    <h2>چرا سازمان‌ها سما را انتخاب می‌کنند؟</h2>
                    <p>نمونه‌ای از تجربه مشتریان در استفاده از راهکارهای نرم‌افزاری سازمانی.</p>
                </div>

                <div class="testimonial-shell">
                    <button class="testimonial-nav testimonial-prev" type="button" data-testimonial-prev aria-label="نظر قبلی">‹</button>

                    <div class="testimonial-slider">
                        <article class="testimonial-slide is-active">
                            <div class="testimonial-header">
                                <div class="quote-mark">”</div>

                                <div class="testimonial-person">
                                    <strong>مدیر مالی</strong>
                                    <span>مشتری سازمانی</span>
                                </div>
                            </div>

                            <p>
                                استفاده از سامانه‌های سما باعث شد بخشی از فرایندهای داخلی ما ساختارمندتر و قابل پیگیری‌تر شود.
                            </p>
                        </article>

                        <article class="testimonial-slide">
                            <div class="testimonial-header">
                                <div class="quote-mark">”</div>

                                <div class="testimonial-person">
                                    <strong>مدیر فناوری اطلاعات</strong>
                                    <span>مشتری سازمانی</span>
                                </div>
                            </div>

                            <p>
                                پشتیبانی و همراهی تیم فنی برای ما مهم بود. امکان دریافت مشاوره و پیگیری سریع، تجربه خوبی ایجاد کرد.
                            </p>
                        </article>

                        <article class="testimonial-slide">
                            <div class="testimonial-header">
                                <div class="quote-mark">”</div>

                                <div class="testimonial-person">
                                    <strong>مدیر منابع انسانی</strong>
                                    <span>مشتری سازمانی</span>
                                </div>
                            </div>

                            <p>
                                نرم‌افزارهای سازمانی زمانی ارزشمند هستند که هم پایدار باشند و هم کاربران بتوانند راحت با آن‌ها کار کنند.
                            </p>
                        </article>
                    </div>

                    <button class="testimonial-nav testimonial-next" type="button" data-testimonial-next aria-label="نظر بعدی">›</button>
                </div>

                <div class="testimonial-dots" data-testimonial-dots>
                    <button type="button" class="is-active" aria-label="نظر ۱"></button>
                    <button type="button" aria-label="نظر ۲"></button>
                    <button type="button" aria-label="نظر ۳"></button>
                </div>
            </div>
        </section>

        <!-- Demo Request Form -->
        <section id="demo-form" class="container demo-section reveal-section">
            <div class="demo-text">
                <span class="demo-badge">شروع همکاری</span>

                <h2>درخواست دمو یا مشاوره</h2>

                <p>
                    برای بررسی نیازهای سازمان، دریافت مشاوره یا مشاهده دمو، فرم را تکمیل کنید.
                    کارشناسان ما پس از بررسی درخواست با شما تماس می‌گیرند.
                </p>

                <div class="demo-benefits">
                    <span>✓ بررسی نیاز سازمان</span>
                    <span>✓ معرفی راهکار مناسب</span>
                    <span>✓ پیگیری توسط تیم پشتیبانی</span>
                </div>
            </div>

            <form id="consultRequestForm" class="demo-form sama-consult-form">
                <input type="hidden" name="formName" value="consult_form" />
                <div class="form-row">
                    <label>
                        نام و نام خانوادگی
                        <input type="text" placeholder="مثلاً: فاطمه کریمی" name="fullName" required />
                    </label>

                    <label>
                        شماره تماس
                        <input type="tel" placeholder="مثلاً: 09120000000" name="mobile" required />
                    </label>
                </div>

                <label>
                    نوع درخواست
                    <select name="requestType" required>
                        <option value="دمو">درخواست دمو</option>
                        <option value="مشاوره">درخواست مشاوره</option>
                    </select>
                </label>

                <label>
                    توضیحات
                    <textarea name="message" placeholder="نیاز یا سوال خود را کوتاه بنویسید..."></textarea>
                </label>

                <button type="submit" data-submit-text="ثبت درخواست مشاوره">
                    ثبت درخواست مشاوره
                </button>

                <div id="consultRequestMessage"></div>
            </form>
        </section>