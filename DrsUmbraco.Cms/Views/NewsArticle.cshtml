@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions

@{
    Layout = null;

    var title = Model.Value<string>("title");
    if (string.IsNullOrWhiteSpace(title))
    {
        title = Model.Name;
    }

    var summary = Model.Value<string>("summary");
    var publishDate = Model.Value<DateTime?>("publishDate");
    var coverImage = Model.Value<MediaWithCrops>("coverImage");
    var newsListUrl = Model.Parent()?.Url() ?? "/اخبار/";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@title</title>

    <link rel="stylesheet" href="/css/sama.css" />
</head>

<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" href="/" aria-label="دیدگاه رایانه سما">
                <img src="/assets/sama/uploads/2024/11/لوگو_ی_شرکت-removebg-preview.png" alt="دیدگاه رایانه سما" />
            </a>

            <nav class="main-nav" aria-label="منوی اصلی">
                <a href="/products">محصولات</a>
                <a href="/recruitment">فرصت های شغلی</a>
                <a href="/contact-us">تماس با ما</a>
                <a href="/about-us">درباره ما</a>
            </nav>

            <div class="header-phone">
                <span>☎</span>
                <strong>۰۲۱-۸۸۳۳۴۱۱۷</strong>
            </div>
        </div>
    </header>

    <main>
        <section class="inner-page-hero news-hero-clean">
            <div class="container">
                <span class="inner-page-badge">خبر</span>

                <h1>@title</h1>

                @if (!string.IsNullOrWhiteSpace(summary))
                {
                    <p>@summary</p>
                }
            </div>
        </section>

        <section class="container article-page reveal-section">
            <article class="article-layout">
                <div class="article-card">
                    @if (coverImage != null)
                    {
                        <img class="article-cover" src="@coverImage.MediaUrl()" alt="@title" />
                    }
                    else
                    {
                        <img class="article-cover" src="/assets/sama/uploads/2024/11/1.jpg" alt="@title" />
                    }

                    <div class="article-content">
                        <div class="article-meta">
                            <span>اخبار و مقالات</span>

                            @if (publishDate.HasValue)
                            {
                                <span>@publishDate.Value.ToString("yyyy/MM/dd")</span>
                            }
                        </div>

                        <h1>@title</h1>

                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p class="article-summary">@summary</p>
                        }

                        <div class="article-body">
                            @Model.Value("body")
                        </div>

                        <div class="article-actions">
                            <a class="article-back-link" href="@newsListUrl">بازگشت به لیست اخبار</a>
                        </div>
                    </div>
                </div>
            </article>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <h3>دسترسی سریع</h3>

                <a href="/recruitment">فرصت های شغلی</a>
                <a href="/contact-us">تماس با ما</a>
                <a href="/about-us">درباره ما</a>
                <a href="/products">محصولات</a>
            </div>

            <div>
                <h3>تماس با ما</h3>

                <p>آدرس: خیابان کارگر شمالی بالاتر از پمپ بنزین پلاک ۲۵۱</p>
                <p>تلفن: ۰۲۱-۸۸۳۳۴۱۱۷</p>
            </div>

            <div>
                <h3>نمادها و مجوزها</h3>

                <div class="footer-logos">
                    <img src="/assets/sama/uploads/2024/11/logo-right-inv4.png" alt="مجوز" />
                    <img src="/assets/sama/uploads/2024/11/شورای-عالی-انفورماتیک-removebg-preview.png" alt="شورای عالی انفورماتیک" />
                </div>
            </div>
        </div>

        <p class="copyright">
            کلیه حقوق مادی و معنوی این سایت متعلق به شرکت دیدگاه رایانه سما می باشد.
        </p>
    </footer>

    <button class="back-to-top" type="button" data-back-to-top aria-label="بازگشت به بالا">⌃</button>

    <script src="/js/sama.js"></script>
</body>
</html>