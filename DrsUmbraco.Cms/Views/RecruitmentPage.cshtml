@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@{
    Layout = "Master.cshtml";

    MediaWithCrops? FirstMedia(IPublishedElement content, string alias)
    {
        var singleMedia = content.Value<MediaWithCrops>(alias);

        if (singleMedia != null)
        {
            return singleMedia;
        }

        var mediaItems = content.Value<IEnumerable<MediaWithCrops>>(alias);

        return mediaItems?.FirstOrDefault();
    }

    var pageTitle = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model.Name;
    }

    ViewData["PageTitle"] = pageTitle;

    var introText = Model.Value<string>("introText");

    var showHero = Model.GetProperty("showHero") == null || Model.Value<bool>("showHero");

    var heroBadgeText = Model.Value<string>("heroBadgeText");
    if (string.IsNullOrWhiteSpace(heroBadgeText))
    {
        heroBadgeText = "همکاری با ما";
    }

    var recruitmentBadge = Model.Value<string>("recruitmentBadge");
    if (string.IsNullOrWhiteSpace(recruitmentBadge))
    {
        recruitmentBadge = "موقعیت‌های فعال";
    }

    var recruitmentTitle = Model.Value<string>("recruitmentTitle");
    if (string.IsNullOrWhiteSpace(recruitmentTitle))
    {
        recruitmentTitle = "فرصت‌های همکاری در سما";
    }

    var recruitmentDescription = Model.Value<string>("recruitmentDescription");
    if (string.IsNullOrWhiteSpace(recruitmentDescription))
    {
        recruitmentDescription = "موقعیت‌های شغلی فعال را بررسی کنید و در صورت علاقه، درخواست همکاری خود را ثبت کنید";
    }

    var heroBackgroundImage = FirstMedia(Model, "heroBackgroundImage");
    var heroBackgroundUrl = heroBackgroundImage?.MediaUrl();

    if (string.IsNullOrWhiteSpace(heroBackgroundUrl))
    {
        heroBackgroundUrl = "/assets/sama/job/job-opportunities-bg.png";
    }

    var jobs = Model.Children()
    .Where(x => x.ContentType.Alias == "jobOpening")
    .OrderBy(x => x.SortOrder)
    .ToList();
}

@if (showHero)
{
    <section class="sama-page-hero sama-page-hero--recruitment" style="--page-hero-image: url('@heroBackgroundUrl');">
        <div class="container sama-page-hero__inner">
            <div class="sama-page-hero__content">
                <span class="sama-page-hero__badge">@heroBadgeText</span>

                <h1>@pageTitle</h1>

                @if (!string.IsNullOrWhiteSpace(introText))
                {
                    <p>@introText</p>
                }
                else
                {
                    <p>ما در دیدگاه رایانه سما به دنبال همکارانی هستیم که به یادگیری، حل مسئله و ساخت نرم‌افزارهای سازمانی علاقه‌مند باشند</p>
                }
            </div>
        </div>
    </section>
}

<section class="container recruitment-page reveal-section">
    <div class="section-heading">
        <span>@recruitmentBadge</span>
        <h2>@recruitmentTitle</h2>
        <p>@recruitmentDescription</p>
    </div>

    @if (jobs.Count == 0)
    {
        <div class="news-empty-state">
            <h2>در حال حاضر موقعیت شغلی فعالی وجود ندارد</h2>
        </div>
    }
    else
    {
        <div class="jobs-grid @(jobs.Count == 1 ? "jobs-grid--single" : "")">
            @foreach (var job in jobs)
            {
                var title = job.Value<string>("title");
                if (string.IsNullOrWhiteSpace(title))
                {
                    title = job.Name;
                }

                var department = job.Value<string>("department");
                var location = job.Value<string>("location");
                var employmentType = job.Value<string>("employmentType");
                var summary = job.Value<string>("summary");

                <a class="sama-job-card" href="@job.Url()">
                    <div class="sama-job-card__body">
                        <span class="sama-job-card__tag">
                            @(string.IsNullOrWhiteSpace(department) ? "فرصت شغلی" : department)
                        </span>

                        <h3 class="sama-job-card__title">@title</h3>

                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p class="sama-job-card__summary">@summary</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(location) ||
                                        !string.IsNullOrWhiteSpace(employmentType))
                        {
                            <div class="sama-job-card__meta">
                                @if (!string.IsNullOrWhiteSpace(location))
                                {
                                    <span class="sama-job-card__chip">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                            <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />
                                            <circle cx="12" cy="10" r="2.5" />
                                        </svg>
                                        <span>@location</span>
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(employmentType))
                                {
                                    <span class="sama-job-card__chip">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                            <circle cx="12" cy="12" r="9" />
                                            <path d="M12 7v5l3 2" />
                                        </svg>
                                        <span>@employmentType</span>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="sama-job-card__footer">
                        <span>مشاهده جزئیات</span>

                        <span class="sama-job-card__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" focusable="false">
                                <path d="M19 12H5 M11 6L5 12L11 18" />
                            </svg>
                        </span>
                    </div>
                </a>
            }
        </div>
    }
</section>