@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Extensions

@{
    Layout = "Master.cshtml";

    var pageTitle = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model.Name;
    }

    ViewData["PageTitle"] = pageTitle;

    var introText = Model.Value<string>("introText");

    var jobs = Model.Children()
        .Where(x => x.ContentType.Alias == "jobOpening")
        .OrderBy(x => x.SortOrder)
        .ToList();
}

<section class="inner-page-hero recruitment-hero-clean">
    <div class="container">
        <span class="inner-page-badge">همکاری با ما</span>

        <h1>@pageTitle</h1>

        @if (!string.IsNullOrWhiteSpace(introText))
        {
            <p>@introText</p>
        }
        else
        {
            <p>
                اگر به یادگیری، حل مسئله و ساخت نرم‌افزارهای سازمانی علاقه‌مند هستید،
                فرصت‌های همکاری با دیدگاه رایانه سما را بررسی کنید.
            </p>
        }
    </div>
</section>

<section class="container recruitment-page reveal-section">
    <div class="section-heading">
        <span>موقعیت‌های فعال</span>
        <h2>فرصت‌های همکاری در سما</h2>
        <p>موقعیت‌های شغلی فعال را بررسی کنید و در صورت علاقه، درخواست همکاری خود را ثبت کنید.</p>
    </div>

    @if (jobs.Count == 0)
    {
        <div class="news-empty-state">
            <h2>در حال حاضر موقعیت شغلی فعالی وجود ندارد</h2>
            <p>در صورت فعال شدن فرصت‌های جدید، این بخش از طریق Umbraco به‌روزرسانی می‌شود.</p>
        </div>
    }
    else
    {
        <div class="jobs-grid">
            @foreach (var job in jobs)
            {
                var title = job.Value<string>("title");
                if (string.IsNullOrWhiteSpace(title))
                {
                    title = job.Name;
                }

                var department = job.Value<string>("department");
                var location = job.Value<string>("location");
                var employmentType = job.Value<string>("employmentType");
                var summary = job.Value<string>("summary");

                <article class="job-card">
                    <div class="job-card-top">
                        <span class="job-tag">
                            @(string.IsNullOrWhiteSpace(department) ? "فرصت شغلی" : department)
                        </span>

                        <h3>@title</h3>

                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p>@summary</p>
                        }
                    </div>

                    <div class="job-meta">
                        @if (!string.IsNullOrWhiteSpace(location))
                        {
                            <span>@location</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(employmentType))
                        {
                            <span>@employmentType</span>
                        }
                    </div>

                    <a class="job-read-more" href="@job.Url()">مشاهده جزئیات</a>
                </article>
            }
        </div>
    }
</section>