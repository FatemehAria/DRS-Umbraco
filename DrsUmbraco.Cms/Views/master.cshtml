@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions

@{
    var siteName = "دیدگاه رایانه سما";

    string? FirstNonEmpty(params string?[] values)
    {
        return values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim();
    }

    var viewPageTitle = ViewData["PageTitle"]?.ToString();

    var seoTitle = FirstNonEmpty(
        Model.Value<string>("seoTitle"),
        viewPageTitle,
        Model.Value<string>("pageTitle"),
        Model.Value<string>("title"),
        Model.Name
    );

    var browserTitle = string.IsNullOrWhiteSpace(seoTitle)
        ? siteName
        : seoTitle.Contains(siteName)
            ? seoTitle
            : $"{seoTitle} | {siteName}";

    var seoDescription = FirstNonEmpty(
        Model.Value<string>("seoDescription"),
        Model.Value<string>("summary"),
        Model.Value<string>("introText")
    );

    var seoImage = Model.Value<MediaWithCrops>("seoImage");

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var canonicalUrl = $"{baseUrl}{Model.Url()}";

    var ogImageUrl = seoImage != null
        ? $"{baseUrl}{seoImage.MediaUrl()}"
        : null;

    var is404Page = Model.ContentType.Alias == "page404";
    var ogType = Model.ContentType.Alias == "newsArticle" ? "article" : "website";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@browserTitle</title>

    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="description" content="@seoDescription" />
    }

    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:site_name" content="@siteName" />
    <meta property="og:title" content="@browserTitle" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonicalUrl" />

    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta property="og:description" content="@seoDescription" />
    }

    @if (!string.IsNullOrWhiteSpace(ogImageUrl))
    {
        <meta property="og:image" content="@ogImageUrl" />
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@browserTitle" />

    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="twitter:description" content="@seoDescription" />
    }

    @if (!string.IsNullOrWhiteSpace(ogImageUrl))
    {
        <meta name="twitter:image" content="@ogImageUrl" />
    }

    @if (is404Page)
    {
        <meta name="robots" content="noindex,follow" />
    }

    <link rel="stylesheet" href="/css/sama.css" />
</head>

<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" href="/" aria-label="دیدگاه رایانه سما">
                <img src="/assets/sama/uploads/2024/11/لوگو_ی_شرکت-removebg-preview.png" alt="دیدگاه رایانه سما" />
            </a>

            <button class="mobile-menu-toggle"
                    type="button"
                    aria-label="باز و بسته کردن منو"
                    aria-controls="mainNavigation"
                    aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav id="mainNavigation" class="main-nav">
                <a href="/products/">محصولات</a>
                <a href="/recruitment/">فرصت‌های شغلی</a>
                <a href="/contact-us/">تماس با ما</a>
                <a href="/about-us/">درباره ما</a>
            </nav>

            <a class="header-phone" href="tel:+982188334117" aria-label="تماس با دیدگاه رایانه سما">
                <span>☎</span>
                <strong>۰۲۱-۸۸۳۳۴۱۱۷</strong>
            </a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <h3>دسترسی سریع</h3>

                <a href="/recruitment">فرصت های شغلی</a>
                <a href="/contact-us">تماس با ما</a>
                <a href="/about-us">درباره ما</a>
                <a href="/products">محصولات</a>
            </div>

            <div class="footer-contact-column">
        <h3>تماس با ما</h3>

        <p>آدرس: خیابان کارگر شمالی بالاتر از پمپ بنزین پلاک ۲۵۱</p>

        <p class="footer-phone-container">
            <span>تلفن:</span>
            <a class="footer-phone-number" href="tel:+982188334117">۰۲۱-۸۸۳۳۴۱۱۷</a>
        </p>

        <div class="footer-social">
                <div class="footer-social-links">
                    <a href="https://eitaa.com/YOUR_EITAA_ID"
                    target="_blank"
                    rel="noopener"
                    aria-label="ایتا دیدگاه رایانه سما">
                        <img src="/assets/sama/uploads/2024/11/Eitaa-Logo.png" alt="ایتا" />
                    </a>

                    <a href="https://ble.ir/YOUR_BALE_ID"
                    target="_blank"
                    rel="noopener"
                    aria-label="بله دیدگاه رایانه سما">
                        <img src="/assets/sama/uploads/2024/11/Bale-Logo.png" alt="بله" />
                    </a>
                </div>
            </div>
        </div>

        <div>
            <h3>نمادها و مجوزها</h3>

            <div class="footer-logos">
                <img src="/assets/sama/uploads/2024/11/Afta-logo.png" alt="مجوز" />
                <img src="/assets/sama/uploads/2024/11/شورای-عالی-انفورماتیک-removebg-preview.png" alt="شورای عالی انفورماتیک" />
            </div>
        </div>
        </div>

        <p class="copyright">
            کلیه حقوق مادی و معنوی این سایت متعلق به شرکت دیدگاه رایانه سما می باشد.
        </p>
    </footer>

    <button class="back-to-top" type="button" data-back-to-top aria-label="بازگشت به بالا">
        <span class="top-arrow">↑</span>
    </button>

    <script src="/js/sama.js"></script>
</body>
</html>