@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.Blocks
@using DrsUmbraco.Cms.Features.Chatbot.Configuration
@using Microsoft.Extensions.Options

@inject IOptions<ChatbotFeatureOptions> ChatbotFeatureOptionsAccessor

@{

    var siteSettings = Umbraco.ContentAtRoot()
    .SelectMany(x => x.DescendantsOrSelf())
    .FirstOrDefault(x => x.ContentType.Alias == "siteSettings");

    var isChatbotEnabled = ChatbotFeatureOptionsAccessor.Value.Enabled;

    var isCustomerPortalPage =
    Context.Request.Path.StartsWithSegments("/پورتال-مشتریان", StringComparison.OrdinalIgnoreCase);

    var headerNavigationLinks = siteSettings?
    .Value<IEnumerable<BlockListItem>>("headerNavigationLinks")?
    .ToList();

    var footerQuickLinks = siteSettings?
    .Value<IEnumerable<BlockListItem>>("footerQuickLinks")?
    .ToList();

    MediaWithCrops? FirstSiteMedia(string alias)
    {
        var singleMedia = siteSettings?.Value<MediaWithCrops>(alias);

        if (singleMedia != null)
        {
            return singleMedia;
        }

        var multipleMedia = siteSettings?.Value<IEnumerable<MediaWithCrops>>(alias);

        return multipleMedia?.FirstOrDefault();
    }

    string SettingOrDefault(string alias, string fallback)
    {
        var value = siteSettings?.Value<string>(alias);

        return string.IsNullOrWhiteSpace(value)
        ? fallback
        : value.Trim();
    }

    string? FirstNonEmpty(params string?[] values)
    {
        return values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim();
    }

    var siteName = SettingOrDefault("siteName", "");
    var siteTagline = SettingOrDefault("siteTagline", "");

    var headerPhoneText = SettingOrDefault("headerPhoneText", "۰۲۱-۸۸۳۳۴۱۱۷");

    var siteLogo = FirstSiteMedia("siteLogo");

    var siteLogoUrl = siteLogo != null
    ? siteLogo.MediaUrl()
    : "/assets/sama/uploads/2024/11/Sama-Logo.webp";

    var footerLicenseLogos = siteSettings?
    .Value<IEnumerable<MediaWithCrops>>("footerLicenseLogos")?
    .Where(x => x != null)
    .ToList();

    var headerPhoneLink = SettingOrDefault("headerPhoneLink", "tel:+982188334117");

    var footerAddress = SettingOrDefault(
    "footerAddress",
    "خیابان کارگر شمالی بالاتر از پمپ بنزین پلاک ۲۵۱"
    );

    var footerPhoneText = SettingOrDefault("footerPhoneText", "۰۲۱-۸۸۳۳۴۱۱۷");
    var footerPhoneLink = SettingOrDefault("footerPhoneLink", "tel:+982188334117");

    var copyrightText = SettingOrDefault(
    "copyrightText",
    "کلیه حقوق مادی و معنوی این سایت متعلق به شرکت دیدگاه رایانه سما می باشد."
    );

    var eitaaUrl = SettingOrDefault("eitaaUrl", "https://eitaa.com/YOUR_EITAA_ID");
    var baleUrl = SettingOrDefault("baleUrl", "https://ble.ir/YOUR_BALE_ID");

    var viewPageTitle = ViewData["PageTitle"]?.ToString();

    var seoTitle = FirstNonEmpty(
    Model.Value<string>("seoTitle"),
    viewPageTitle,
    Model.Value<string>("pageTitle"),
    Model.Value<string>("title"),
    Model.Name
    );

    var browserTitle = string.IsNullOrWhiteSpace(seoTitle)
    ? siteName
    : seoTitle.Contains(siteName)
    ? seoTitle
    : $"{seoTitle} | {siteName}";

    var seoDescription = FirstNonEmpty(
    Model.Value<string>("seoDescription"),
    Model.Value<string>("summary"),
    Model.Value<string>("introText")
    );

    var seoImage = Model.Value<MediaWithCrops>("seoImage") ?? FirstSiteMedia("defaultOgImage");

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var canonicalUrl = $"{baseUrl}{Model.Url()}";

    var ogImageUrl = seoImage != null
    ? $"{baseUrl}{seoImage.MediaUrl()}"
    : null;

    var is404Page = Model.ContentType.Alias == "page404";
    var ogType = Model.ContentType.Alias == "newsArticle" ? "article" : "website";

    string NormalizePath(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return string.Empty;
        }

        url = url.Trim();

        if (url.StartsWith("#") ||
        url.StartsWith("tel:", StringComparison.OrdinalIgnoreCase) ||
        url.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        if (Uri.TryCreate(url, UriKind.Absolute, out var absoluteUri))
        {
            url = absoluteUri.AbsolutePath;
        }

        url = url.Split('?')[0].Split('#')[0].Trim();

        if (string.IsNullOrWhiteSpace(url))
        {
            return "/";
        }

        return "/" + url.Trim('/').ToLowerInvariant();
    }

    bool PathMatches(string currentPath, string targetPath)
    {
        if (string.IsNullOrWhiteSpace(currentPath) ||
        string.IsNullOrWhiteSpace(targetPath))
        {
            return false;
        }

        if (targetPath == "/")
        {
            return currentPath == "/";
        }

        return currentPath == targetPath ||
        currentPath.StartsWith(targetPath + "/");
    }

    bool IsActiveNavLink(string? url)
    {
        var targetPath = NormalizePath(url);

        if (string.IsNullOrWhiteSpace(targetPath))
        {
            return false;
        }

        var requestPath = NormalizePath(Context.Request.Path.Value);
        var modelPath = NormalizePath(Model.Url());

        // حالت اول:
        // آدرس صفحه فعلی دقیقاً همان لینک منو باشد
        // یا URL صفحه زیرمجموعه URL لینک منو باشد.
        var matchesUrl =
        PathMatches(requestPath, targetPath) ||
        PathMatches(modelPath, targetPath);

        // حالت دوم:
        // صفحه فعلی در درخت محتوای Umbraco
        // زیرمجموعه صفحه‌ای مثل Products یا Recruitment باشد.
        var matchesContentTree = Model
        .AncestorsOrSelf()
        .Any(content =>
        NormalizePath(content.Url()) == targetPath);

        return matchesUrl || matchesContentTree;
    }

    bool IsCustomerPortalLink(string? linkText, string? linkUrl)
    {
        var normalizedUrl = NormalizePath(linkUrl);

        return normalizedUrl == "/customer-portal" ||
        normalizedUrl == "/customer-portal/" ||
        (!string.IsNullOrWhiteSpace(linkText) &&
        linkText.Contains("پورتال مشتریان"));
    }

    var portalLinkText = "پورتال مشتریان";
    var portalLinkUrl = "/customer-portal/";
    var portalOpenInNewTab = false;

    var portalNavItem = headerNavigationLinks?
    .FirstOrDefault(x =>
    {
        var text = x.Content.Value<string>("linkText");
        var url = x.Content.Value<string>("linkUrl");

        return IsCustomerPortalLink(text, url);
    });

    if (portalNavItem != null)
    {
        var text = portalNavItem.Content.Value<string>("linkText");
        var url = portalNavItem.Content.Value<string>("linkUrl");
        var openInNewTab = portalNavItem.Content.Value<bool>("openInNewTab");

        if (!string.IsNullOrWhiteSpace(text))
        {
            portalLinkText = text;
        }

        if (!string.IsNullOrWhiteSpace(url))
        {
            portalLinkUrl = url;
        }

        portalOpenInNewTab = openInNewTab;
    }

}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@browserTitle</title>

    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="description" content="@seoDescription" />
    }

    <link rel="canonical" href="@canonicalUrl" />

    <meta property="og:site_name" content="@siteName" />
    <meta property="og:title" content="@browserTitle" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonicalUrl" />

    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta property="og:description" content="@seoDescription" />
    }

    @if (!string.IsNullOrWhiteSpace(ogImageUrl))
    {
        <meta property="og:image" content="@ogImageUrl" />
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@browserTitle" />

    @if (!string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="twitter:description" content="@seoDescription" />
    }

    @if (!string.IsNullOrWhiteSpace(ogImageUrl))
    {
        <meta name="twitter:image" content="@ogImageUrl" />
    }

    @if (is404Page)
    {
        <meta name="robots" content="noindex,follow" />
    }

    @if (isChatbotEnabled)
    {
        <link rel="stylesheet" href="/css/chatbot.css" />
    }

    <link rel="stylesheet" href="~/css/sama.bundle.min.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo site-brand" href="/" aria-label="@siteName">
                <img src="@siteLogoUrl" alt="@siteName" />

                <!-- <span class="site-brand__text"> -->
                <!-- <strong>@siteName</strong> -->

                <!-- @if (!string.IsNullOrWhiteSpace(siteTagline))
                    {
                                                        <small>@siteTagline</small>
                    }
 -->
                <!-- </span> -->
            </a>

            <button class="mobile-menu-toggle" type="button" aria-label="باز و بسته کردن منو"
                aria-controls="mainNavigation" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav id="mainNavigation" class="main-nav">
                @if (headerNavigationLinks?.Any() == true)
                {
                    foreach (var navItem in headerNavigationLinks)
                    {
                        var linkText = navItem.Content.Value<string>("linkText");
                        var linkUrl = navItem.Content.Value<string>("linkUrl");
                        var openInNewTab = navItem.Content.Value<bool>("openInNewTab");

                        if (!string.IsNullOrWhiteSpace(linkText) &&
                        !string.IsNullOrWhiteSpace(linkUrl))
                        {
                            if (IsCustomerPortalLink(linkText, linkUrl))
                            {
                                continue;
                            }

                            var isActive = IsActiveNavLink(linkUrl);

                            <a href="@linkUrl" class="@(isActive ? "is-active" : null)" aria-current="@(isActive ? "page" : null)"
                                target="@(openInNewTab ? "_blank" : null)" rel="@(openInNewTab ? "noopener" : null)">
                                @linkText
                            </a>
                        }
                    }
                }
                else
                {
                    <a href="/products/" class="@(IsActiveNavLink("/products/") ? "is-active" : null)">محصولات</a>
                    <a href="/recruitment/" class="@(IsActiveNavLink("/recruitment/") ? "is-active" : null)">فرصت‌های
                        شغلی</a>
                    <a href="/contact-us/" class="@(IsActiveNavLink("/contact-us/") ? "is-active" : null)">تماس با ما</a>
                    <a href="/about-us/" class="@(IsActiveNavLink("/about-us/") ? "is-active" : null)">درباره ما</a>
                }
            </nav>

            @if (!string.IsNullOrWhiteSpace(headerPhoneText) &&
                        !string.IsNullOrWhiteSpace(headerPhoneLink))
            {
                <div class="header-actions">
                    @if (!isCustomerPortalPage)
                    {
                        <a class="header-portal-btn @(IsActiveNavLink(portalLinkUrl) ? "is-active" : null)"
                            href="@portalLinkUrl" aria-current="@(IsActiveNavLink(portalLinkUrl) ? "page" : null)"
                            target="@(portalOpenInNewTab ? "_blank" : null)" rel="@(portalOpenInNewTab ? "noopener" : null)">
                            <span>پورتال مشتریان</span>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(headerPhoneText) &&
                                    !string.IsNullOrWhiteSpace(headerPhoneLink))
                    {
                        <a class="header-phone" href="@headerPhoneLink" aria-label="تماس با @siteName">
                            <span>☎</span>
                            <strong>@headerPhoneText</strong>
                        </a>
                    }
                </div>
            }
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <h3>دسترسی سریع</h3>

                @if (footerQuickLinks?.Any() == true)
                {
                    foreach (var navItem in footerQuickLinks)
                    {
                        var linkText = navItem.Content.Value<string>("linkText");
                        var linkUrl = navItem.Content.Value<string>("linkUrl");
                        var openInNewTab = navItem.Content.Value<bool>("openInNewTab");

                        if (!string.IsNullOrWhiteSpace(linkText) &&
                        !string.IsNullOrWhiteSpace(linkUrl))
                        {
                            var isFooterActive = IsActiveNavLink(linkUrl);

                            <a href="@linkUrl" class="@(isFooterActive ? "is-active" : null)"
                                aria-current="@(isFooterActive ? "page" : null)" target="@(openInNewTab ? "_blank" : null)"
                                rel="@(openInNewTab ? "noopener" : null)">
                                @linkText
                            </a>
                        }
                    }
                }
                <!-- else
                {
                    <a href="/recruitment">فرصت های شغلی</a>
                    <a href="/contact-us">تماس با ما</a>
                    <a href="/about-us">درباره ما</a>
                    <a href="/products">محصولات</a>
                } -->
            </div>

            <div class="footer-contact-column">
                <h3>تماس با ما</h3>

                @if (!string.IsNullOrWhiteSpace(footerAddress))
                {
                    <p>آدرس: @footerAddress</p>
                }

                @if (!string.IsNullOrWhiteSpace(footerPhoneText) &&
                                !string.IsNullOrWhiteSpace(footerPhoneLink))
                {
                    <p class="footer-phone-container">
                        <span>تلفن:</span>
                        <a class="footer-phone-number" href="@footerPhoneLink">
                            @footerPhoneText
                        </a>
                    </p>
                }

                <div class="footer-social">
                    <div class="footer-social-links">
                        @if (!string.IsNullOrWhiteSpace(eitaaUrl))
                        {
                            <a href="@eitaaUrl" target="_blank" rel="noopener" aria-label="ایتا @siteName">
                                <img src="/assets/sama/uploads/2024/11/Eitaa-Logo.webp" alt="ایتا" />
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(baleUrl))
                        {
                            <a href="@baleUrl" target="_blank" rel="noopener" aria-label="بله @siteName">
                                <img src="/assets/sama/uploads/2024/11/Bale-Logo.webp" alt="بله" />
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div>
                <h3>نمادها و مجوزها</h3>

                <div class="footer-logos">
                    @if (footerLicenseLogos?.Any() == true)
                    {
                        foreach (var logo in footerLicenseLogos)
                        {
                            <img src="@logo.MediaUrl()" alt="نماد یا مجوز @siteName" />
                        }
                    }
                    else
                    {
                        <img src="/assets/sama/uploads/2024/11/Afta-logo.webp" alt="مجوز" class="footer-logo-it" />
                        <img src="/assets/sama/uploads/2024/11/Informatics.webp" alt="شورای عالی انفورماتیک" />
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(copyrightText))
        {
            <p class="copyright">
                @copyrightText
            </p>
        }
    </footer>

    <button class="back-to-top" type="button" data-back-to-top aria-label="بازگشت به بالا">
        <span class="top-arrow">↑</span>
    </button>

    @if (isChatbotEnabled)
    {
        <partial name="Chatbot/ChatbotWidget" />

        <script src="/js/chatbot.js"></script>
    }

    <script src="/js/sama.js"></script>
</body>

</html>