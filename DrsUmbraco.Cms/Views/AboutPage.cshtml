@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@{
    Layout = "Master.cshtml";

    MediaWithCrops? FirstMedia(IPublishedElement content, string alias)
    {
        var singleMedia = content.Value<MediaWithCrops>(alias);

        if (singleMedia != null)
        {
            return singleMedia;
        }

        var mediaItems = content.Value<IEnumerable<MediaWithCrops>>(alias);

        return mediaItems?.FirstOrDefault();
    }

    var pageTitle = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model.Name;
    }

    ViewData["PageTitle"] = pageTitle;

    var introText = Model.Value<string>("introText");
    var body = Model.Value("body");
    var missionText = Model.Value<string>("missionText");
    var visionText = Model.Value<string>("visionText");
    var heroImage = Model.Value<MediaWithCrops>("heroImage");

    var showHero = Model.GetProperty("showHero") == null || Model.Value<bool>("showHero");

    var heroBadgeText = Model.Value<string>("heroBadgeText");
    if (string.IsNullOrWhiteSpace(heroBadgeText))
    {
        heroBadgeText = "درباره ما";
    }

    var heroBackgroundImage = FirstMedia(Model, "heroBackgroundImage");
    var heroBackgroundUrl = heroBackgroundImage?.MediaUrl();

    if (string.IsNullOrWhiteSpace(heroBackgroundUrl))
    {
        heroBackgroundUrl = "/assets/sama/about/about-us-hero-bg.png";
    }
}

@if (showHero)
{
    <section class="sama-page-hero sama-page-hero--about" style="--page-hero-image: url('@heroBackgroundUrl');">
        <div class="container sama-page-hero__inner">
            <div class="sama-page-hero__content">
                <span class="sama-page-hero__badge">@heroBadgeText</span>

                <h1>@pageTitle</h1>

                @if (!string.IsNullOrWhiteSpace(introText))
                {
                    <p>@introText</p>
                }
                else
                {
                    <p>
                        شرکت دیدبان شبکه سما با تکیه بر دانش فنی، تجربه و شناخت نیازهای
                        سازمانی، راهکارهای نرم‌افزاری قابل اعتماد و توسعه‌پذیر ارائه می‌دهد.
                    </p>
                }
            </div>
        </div>
    </section>
}

<section class="container about-page reveal-section">
    <div class="about-layout">
        <article class="about-content-card">
            <span class="section-mini-badge">معرفی شرکت</span>

            <h2>ما چه کاری انجام می‌دهیم؟</h2>

            <div class="about-body">
                @body
            </div>
        </article>

        <aside class="about-side-panel">
            @if (heroImage != null)
            {
                <!-- <img src="@heroImage.MediaUrl()" alt="@pageTitle" /> -->
                <img src="/assets/sama/about/aboutus-img2.webp" alt="@pageTitle" /> 
            }
            else
            {
                <img src="/assets/sama/about/aboutus-img2.webp" alt="@pageTitle" />
            }

            <div class="about-side-caption">
                <strong>راهکارهای نرم‌افزاری سازمانی</strong>
                <span>تمرکز بر پایداری، توسعه‌پذیری و پشتیبانی بلندمدت</span>
            </div>
        </aside>
    </div>
</section>

<section class="container about-values-section reveal-section">
    <div class="about-values-grid">
        <article class="about-value-card">
            <span>ماموریت</span>
            <h3>ارائه راهکارهای قابل اعتماد</h3>

            @if (!string.IsNullOrWhiteSpace(missionText))
            {
                <p>@missionText</p>
            }
            else
            {
                <p>ارائه نرم‌افزارهایی پایدار، قابل توسعه و متناسب با نیاز سازمان‌ها.</p>
            }
        </article>

        <article class="about-value-card">
            <span>چشم‌انداز</span>
            <h3>همراهی با تحول دیجیتال سازمان‌ها</h3>

            @if (!string.IsNullOrWhiteSpace(visionText))
            {
                <p>@visionText</p>
            }
            else
            {
                <p>تبدیل شدن به انتخابی قابل اعتماد برای مدیریت فرایندهای سازمانی.</p>
            }
        </article>

        <article class="about-value-card">
            <span>رویکرد</span>
            <h3>تمرکز بر نیاز واقعی سازمان</h3>
            <p>
                ما تلاش می‌کنیم راهکارها فقط از نظر فنی مناسب نباشند، بلکه با فرایندها و نیازهای واقعی سازمان نیز هماهنگ باشند.
            </p>
        </article>
    </div>
</section>