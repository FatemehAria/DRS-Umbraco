@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions

@{
    Layout = "Master.cshtml";

    MediaWithCrops? FirstMedia(IPublishedElement content, string alias)
    {
        var singleMedia = content.Value<MediaWithCrops>(alias);

        if (singleMedia != null)
        {
            return singleMedia;
        }

        var mediaItems = content.Value<IEnumerable<MediaWithCrops>>(alias);

        return mediaItems?.FirstOrDefault();
    }

    var pageTitle = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model.Name;
    }

    ViewData["PageTitle"] = pageTitle;

    var introText = Model.Value<string>("introText");

    var showHero = Model.GetProperty("showHero") == null || Model.Value<bool>("showHero");

    var heroBadgeText = Model.Value<string>("heroBadgeText");
    if (string.IsNullOrWhiteSpace(heroBadgeText))
    {
        heroBadgeText = "تماس با ما";
    }

    var heroBackgroundImage = FirstMedia(Model, "heroBackgroundImage");
    var heroBackgroundUrl = heroBackgroundImage?.MediaUrl();

    if (string.IsNullOrWhiteSpace(heroBackgroundUrl))
    {
        heroBackgroundUrl = "/assets/sama/contact/contact-us-bg.png";
    }

    var address = Model.Value<string>("address");
    var phone = Model.Value<string>("phone");
    var workingHours = Model.Value<string>("workingHours");

    var contactInfoBadgeText = Model.Value<string>("contactInfoBadgeText");
    if (string.IsNullOrWhiteSpace(contactInfoBadgeText))
    {
        contactInfoBadgeText = "اطلاعات تماس";
    }

    var contactInfoTitleText = Model.Value<string>("contactInfoTitle");
    if (string.IsNullOrWhiteSpace(contactInfoTitleText))
    {
        contactInfoTitleText = "راه‌های ارتباطی";
    }

    var contactFormBadge = Model.Value<string>("contactFormBadge");
    if (string.IsNullOrWhiteSpace(contactFormBadge))
    {
        contactFormBadge = "فرم تماس";
    }

    var contactFormTitle = Model.Value<string>("contactFormTitle");
    if (string.IsNullOrWhiteSpace(contactFormTitle))
    {
        contactFormTitle = "ارسال پیام";
    }

    var contactFormDescription = Model.Value<string>("contactFormDescription");
    if (string.IsNullOrWhiteSpace(contactFormDescription))
    {
        contactFormDescription = "پیام، سوال یا درخواست خود را ارسال کنید. تیم ما پس از بررسی، در صورت نیاز با شما تماس می‌گیرد.";
    }

    var contactInfoBlocks = Model.Value<BlockListModel>("contactInfoItems");
    var contactFormOptions = Model.Value<BlockListModel>("contactFormOptions");
}

@if (showHero)
{
    <section class="sama-page-hero sama-page-hero--contact" style="--page-hero-image: url('@heroBackgroundUrl');">
        <div class="container sama-page-hero__inner">
            <div class="sama-page-hero__content">
                <span class="sama-page-hero__badge">@heroBadgeText</span>

                <h1>@pageTitle</h1>

                @if (!string.IsNullOrWhiteSpace(introText))
                {
                    <p>@introText</p>
                }
                else
                {
                    <p>
                        برای دریافت مشاوره، درخواست دمو یا ارتباط با تیم دیدگاه رایانه سما،
                        از طریق اطلاعات تماس یا فرم زیر با ما در ارتباط باشید.
                    </p>
                }
            </div>
        </div>
    </section>
}

<section class="container contact-page reveal-section">
    <div class="contact-grid">
        <div class="contact-info-panel">
            <span class="section-mini-badge">@contactInfoBadgeText</span>

            <h2>@contactInfoTitleText</h2>

            <div class="contact-info-list">
                @if (contactInfoBlocks != null && contactInfoBlocks.Any())
                {
                    foreach (var block in contactInfoBlocks)
                    {
                        var item = block.Content;

                        var isVisible = item.GetProperty("isVisible") == null || item.Value<bool>("isVisible");

                        if (!isVisible)
                        {
                            continue;
                        }

                        var title = item.Value<string>("contactInfoTitle");
                        var text = item.Value<string>("contactInfoText");
                        var icon = FirstMedia(item, "contactInfoIcon");

                        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(text))
                        {
                            continue;
                        }

                        <div class="contact-info-item">
                            @if (icon != null)
                            {
                                <span class="contact-info-icon" aria-hidden="true">
                                    <img src="@icon.MediaUrl()" alt="" loading="lazy" />
                                </span>
                            }

                            <div class="contact-info-content">
                                <strong>@title</strong>
                                <p>@text</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="contact-info-item">
                        <div class="contact-info-content">
                            <strong>آدرس</strong>
                            <p>@(string.IsNullOrWhiteSpace(address) ? "خیابان کارگر شمالی بالاتر از پمپ بنزین پلاک ۲۵۱" :
                                                            address)</p>
                        </div>
                    </div>

                    <div class="contact-info-item">
                        <div class="contact-info-content">
                            <strong>تلفن</strong>
                            <p>@(string.IsNullOrWhiteSpace(phone) ? "۰۲۱-۸۸۳۳۴۱۱۷" : phone)</p>
                        </div>
                    </div>

                    <div class="contact-info-item">
                        <div class="contact-info-content">
                            <strong>ساعات کاری</strong>
                            <p>@(string.IsNullOrWhiteSpace(workingHours) ? "شنبه تا چهارشنبه، ساعت ۸ تا ۱۶" : workingHours)
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="contact-form-panel">
            <span class="section-mini-badge">@contactFormBadge</span>

            <h2>@contactFormTitle</h2>

            <p>@contactFormDescription</p>

            <form id="consultRequestForm" class="demo-form sama-consult-form contact-form"
                data-success-message="پیام شما با موفقیت ثبت شد. تیم ما در صورت نیاز با شما تماس می‌گیرد." novalidate>
                <input type="hidden" name="formName" value="contact_form" />
                <div class="form-honeypot" aria-hidden="true">
                    <label for="website">Website</label>
                    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
                </div>
                <div class="form-row">
                    <label>
                        نام و نام خانوادگی
                        <input type="text" placeholder="مثلاً: فاطمه کریمی" name="fullName" minlength="2"
                            maxlength="100" required />
                    </label>

                    <label>
                        شماره تماس
                        <input type="tel" placeholder="مثلاً: 09120000000" name="mobile" minlength="11" maxlength="11"
                            pattern="09[0-9]{9}" title="شماره موبایل باید با 09 شروع شود و دقیقاً 11 رقم باشد."
                            inputmode="numeric" required />
                    </label>
                </div>

                @* <label>
                    موضوع پیام
                    <select name="requestType" required>
                        <option value="ارتباط عمومی">ارتباط عمومی</option>
                        <option value="پشتیبانی">پشتیبانی</option>
                        <option value="پیگیری درخواست">پیگیری درخواست</option>
                        <option value="سایر">سایر</option>
                    </select>
                </label> *@

                <div class="form-field">
                    <label for="contactRequestType">
                        موضوع پیام
                    </label>

                    <select id="contactRequestType" class="js-tom-select" name="requestType" dir="rtl" required>
                        @if (contactFormOptions != null && contactFormOptions.Any())
                        {
                            foreach (var block in contactFormOptions)
                            {
                                var item = block.Content;
                                var isVisible = item.GetProperty("isVisible") == null ||
                                item.Value<bool>("isVisible");

                                if (!isVisible)
                                {
                                    continue;
                                }

                                var title = item.Value<string>("title");
                                var value = item.Value<string>("value");

                                if (string.IsNullOrWhiteSpace(title) ||
                                string.IsNullOrWhiteSpace(value))
                                {
                                    continue;
                                }

                                <option value="@value">@title</option>
                            }
                        }
                        else
                        {
                            <option value="ارتباط عمومی">ارتباط عمومی</option>
                        }
                    </select>
                </div>

                <label>
                    پیام شما
                    <textarea name="message" placeholder="پیام یا سوال خود را بنویسید..." maxlength="2000"
                        required></textarea>
                </label>

                <button type="submit" data-submit-text="ارسال پیام">
                    ارسال پیام
                </button>

                <div id="consultRequestMessage"></div>
            </form>
        </div>
    </div>
</section>