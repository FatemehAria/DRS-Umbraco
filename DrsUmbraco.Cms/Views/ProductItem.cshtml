@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions

@{
    Layout = "Master.cshtml";


    MediaWithCrops? GetFirstMedia(string alias)
    {
        var singleMedia = Model.Value<MediaWithCrops>(alias);

        if (singleMedia != null)
        {
            return singleMedia;
        }

        var mediaItems = Model.Value<IEnumerable<MediaWithCrops>>(alias);

        return mediaItems?.FirstOrDefault();
    }

    var title = Model.Value<string>("title");
    if (string.IsNullOrWhiteSpace(title))
    {
        title = Model.Name;
    }

    ViewData["PageTitle"] = title;

    var icon = GetFirstMedia("icon");
    var summary = Model.Value<string>("summary");
    var productListUrl = Model.Parent()?.Url() ?? "/products/";

    var demoRequestType = $"درخواست دمو - {title}";
    var consultingRequestType = $"درخواست مشاوره - {title}";

    var productHeroHighlightBadges = Model.Value<BlockListModel>("productHeroHighlightBadges");

    var solutionDescription = Model.Value<string>("solutionDescription");
    var solutionList = Model.Value<BlockListModel>("solutionList");

    var productDescriptionBadge = Model.Value<string>("productDescriptionBadge");
    if (string.IsNullOrWhiteSpace(productDescriptionBadge))
    {
        productDescriptionBadge = "معرفی محصول";
    }

    var suitableForBadge = Model.Value<string>("suitableForBadge");
    if (string.IsNullOrWhiteSpace(suitableForBadge))
    {
        suitableForBadge = "مناسب برای";
    }

    var suitableForTitle = Model.Value<string>("suitableForTitle");
    if (string.IsNullOrWhiteSpace(suitableForTitle))
    {
        suitableForTitle = "این محصول برای چه سازمان‌هایی مناسب است؟";
    }

    var suitableForBody = Model.Value<string>("suitableForBody");
    if (string.IsNullOrWhiteSpace(suitableForBody))
    {
        suitableForBody = "این راهکار برای سازمان‌هایی مناسب است که می‌خواهند فرآیندهای خود را ساختارمندتر، قابل پیگیری‌تر و گزارش‌پذیرتر مدیریت کنند.";
    }

    var suitableForList = Model.Value<BlockListModel>("suitableForList");
}

<section class="inner-page-hero product-detail-hero product-detail-hero-v2">
    <div class="container product-detail-hero-grid-v2">
        <div class="product-detail-hero-copy">
            <span class="inner-page-badge">محصولات</span>

            <h1>@title</h1>

            @if (!string.IsNullOrWhiteSpace(summary))
            {
                <p>@summary</p>
            }
            else
            {
                <p>
                    راهکاری سازمانی برای مدیریت بهتر اطلاعات، فرآیندها و گزارش‌های عملیاتی سازمان.
                </p>
            }

            @if (productHeroHighlightBadges != null && productHeroHighlightBadges.Any())
            {
                <div class="product-detail-badges">
                    @foreach (var block in productHeroHighlightBadges)
                    {
                        var item = block.Content;
                        var itemTitle = item.Value<string>("title");

                        @if (!string.IsNullOrWhiteSpace(itemTitle))
                        {
                            <span>@itemTitle</span>
                        }
                    }
                </div>
            }
            <div class="product-detail-actions">
                <a class="ui-btn ui-btn-primary" href="#demo-form">درخواست دمو</a>
                <a class="ui-btn ui-btn-outline" href="@productListUrl">بازگشت به محصولات</a>
            </div>
        </div>

        <aside class="product-detail-hero-panel">
            <div class="product-detail-icon">
                @if (icon != null)
                {
                    <img src="@icon.MediaUrl()" alt="" />
                }
            </div>

            <h2>راهکار @title</h2>

            @if (!string.IsNullOrWhiteSpace(solutionDescription))
            {
            <p>@solutionDescription</p>
            }
            else
            {
            <p>
                مناسب برای سازمان‌هایی که به دنبال مدیریت ساختارمندتر، گزارش‌پذیرتر و قابل پیگیری‌تر هستند.
            </p>
            }

            @if (solutionList != null && solutionList.Any())
            {
                <ul>
                    @foreach (var block in solutionList)
                    {
                        var item = block.Content;
                        var itemTitle = item.Value<string>("title");

                        @if (!string.IsNullOrWhiteSpace(itemTitle))
                        {
                            <li>@itemTitle</li>
                        }
                    }
                </ul>
            }
        </aside>
    </div>
</section>

<section class="container product-detail-page reveal-section">
    <div class="product-detail-layout-v2">
        <article class="product-detail-content-card product-detail-main-card sama-detail-card">
            <div class="product-detail-content sama-detail-card__content">
                <span class="section-mini-badge">@productDescriptionBadge</span>

                <h2>درباره @title</h2>

                <div class="product-detail-body">
                    @Model.Value("body")
                </div>
            </div>

            <a class="sama-detail-back" href="@productListUrl">
                <span>بازگشت به لیست محصولات</span>

                <span class="sama-detail-back__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" focusable="false">
                        <path d="M19 12H5 M11 6L5 12L11 18" />
                    </svg>
                </span>
            </a>
        </article>

        <aside class="product-detail-side-card product-fit-card">
            <span class="section-mini-badge">@suitableForBadge</span>

            <h3>@suitableForTitle</h3>

            <p>@suitableForBody</p>

            @if (suitableForList != null && suitableForList.Any())
            {
                <ul class="product-fit-list">
                    @foreach (var block in suitableForList)
                    {
                        var item = block.Content;
                        var itemTitle = item.Value<string>("title");

                        @if (!string.IsNullOrWhiteSpace(itemTitle))
                        {
                            <li>@itemTitle</li>
                        }
                    }
                </ul>
            }
        </aside>
    </div>
</section>

<section id="demo-form" class="container demo-section reveal-section">
    <div class="demo-text">
        <span class="demo-badge">فرم درخواست</span>

        <h2>درخواست دمو برای @title</h2>

        <p>
            برای مشاهده دمو یا دریافت اطلاعات بیشتر درباره این محصول، فرم را تکمیل کنید.
            تیم ما پس از بررسی درخواست با شما تماس می‌گیرد.
        </p>

        <div class="demo-benefits">
            <span>✓ بررسی نیاز سازمان</span>
            <span>✓ معرفی راهکار مناسب</span>
            <span>✓ پیگیری توسط تیم پشتیبانی</span>
        </div>
    </div>

    <form id="consultRequestForm" class="demo-form sama-consult-form" novalidate>
        <input type="hidden" name="formName" value="product_demo_form" />
        <div class="form-row">
            <label>
                نام و نام خانوادگی
                <input type="text" placeholder="مثلاً: فاطمه کریمی" name="fullName" minlength="2" maxlength="100"
                    required />
            </label>

            <label>
                شماره تماس
                <input type="tel" placeholder="مثلاً: 09120000000" name="mobile" minlength="11" maxlength="11"
                    pattern="09[0-9]{9}" title="شماره موبایل باید با 09 شروع شود و دقیقاً 11 رقم باشد."
                    inputmode="numeric" required />
            </label>
        </div>

        @* <label>
            نوع درخواست
            <select name="requestType" required>
                <option value="@demoRequestType">درخواست دمو</option>
                <option value="@consultingRequestType">درخواست مشاوره</option>
            </select>
        </label> *@

        <div class="form-field">
            <label for="productRequestType">
                نوع درخواست
            </label>

            <select id="productRequestType" class="js-tom-select" name="requestType" dir="rtl" required>
                <option value="@demoRequestType">
                    درخواست دمو
                </option>

                <option value="@consultingRequestType">
                    درخواست مشاوره
                </option>
            </select>
        </div>

        <label>
            توضیحات
            <textarea name="message" placeholder="نیاز یا سوال خود را کوتاه بنویسید..." maxlength="2000"></textarea>
        </label>

        <button type="submit" data-submit-text="ثبت درخواست">
            ثبت درخواست
        </button>

        <div id="consultRequestMessage"></div>
    </form>
</section>