@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions

@{
    Layout = "Master.cshtml";

    var pageTitle = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model.Name;
    }

    ViewData["PageTitle"] = pageTitle;

    var introText = Model.Value<string>("introText");

    var newsItems = Model.Children()
        .Where(x => x.ContentType.Alias == "newsArticle")
        .OrderByDescending(x => x.Value<DateTime?>("publishDate") ?? x.CreateDate)
        .ToList();
}

<section class="inner-page-hero news-hero-clean">
    <div class="container">
        <span class="inner-page-badge">اخبار و مقالات</span>

        <h1>@pageTitle</h1>

        @if (!string.IsNullOrWhiteSpace(introText))
        {
            <p>@introText</p>
        }
        else
        {
            <p>
                تازه‌ترین اخبار، مقاله‌ها و مطالب منتشرشده درباره نرم‌افزارهای سازمانی،
                تحول دیجیتال و راهکارهای دیدگاه رایانه سما.
            </p>
        }
    </div>
</section>

<section class="container news-list-page reveal-section">
    @if (newsItems.Count == 0)
    {
        <div class="news-empty-state">
            <h2>هنوز خبری منتشر نشده است</h2>
            <p>بعد از انتشار خبرها در Umbraco، در این بخش نمایش داده می‌شوند.</p>
        </div>
    }
    else
    {
        <div class="news-grid news-grid-premium">
            @foreach (var item in newsItems)
            {
                var title = item.Value<string>("title");
                if (string.IsNullOrWhiteSpace(title))
                {
                    title = item.Name;
                }

                var summary = item.Value<string>("summary");
                var publishDate = item.Value<DateTime?>("publishDate");
                var image = item.Value<MediaWithCrops>("coverImage");

                <article class="news-card news-card-premium">
                    <a href="@item.Url()" class="news-image-link">
                        @if (image != null)
                        {
                            <img src="@image.MediaUrl()" alt="@title" />
                        }
                        else
                        {
                            <img src="/assets/sama/uploads/2024/11/1.jpg" alt="@title" />
                        }
                    </a>

                    <div class="news-card-body">
                        <span class="news-meta">
                            @(publishDate.HasValue ? publishDate.Value.ToString("yyyy/MM/dd") : "اخبار")
                        </span>

                        <h3>@title</h3>

                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p>@summary</p>
                        }

                        <a href="@item.Url()" class="news-read-more">مشاهده خبر</a>
                    </div>
                </article>
            }
        </div>
    }
</section>