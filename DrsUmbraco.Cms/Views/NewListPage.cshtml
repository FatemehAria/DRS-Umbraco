@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions

@{
    Layout = null;

    var pageTitle = Model.Value<string>("pageTitle");
    if (string.IsNullOrWhiteSpace(pageTitle))
    {
        pageTitle = Model.Name;
    }

    var introText = Model.Value<string>("introText");

    var newsItems = Model.Children()
        .Where(x => x.ContentType.Alias == "newsArticle")
        .OrderByDescending(x => x.Value<DateTime?>("publishDate"));
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@pageTitle</title>
    <link rel="stylesheet" href="/css/sama.css" />

    <style>
        .news-list-page {
            max-width: 1200px;
            margin: 60px auto;
            padding: 0 20px;
            direction: rtl;
            text-align: right;
        }

        .news-list-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .news-list-header h1 {
            font-size: 34px;
            margin-bottom: 12px;
        }

        .news-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .news-card {
            display: block;
            background: #fff;
            border-radius: 18px;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 8px 28px rgba(0,0,0,.08);
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .news-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 34px rgba(0,0,0,.12);
        }

        .news-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .news-card-content {
            padding: 20px;
        }

        .news-card-content h2 {
            font-size: 20px;
            margin-bottom: 12px;
        }

        .news-card-content p {
            color: #666;
            line-height: 1.9;
        }

        @@media (max-width: 900px) {
            .news-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <main class="news-list-page">
        <header class="news-list-header">
            <h1>@pageTitle</h1>

            @if (!string.IsNullOrWhiteSpace(introText))
            {
                <p>@introText</p>
            }
        </header>

        <section class="news-grid">
            @foreach (var item in newsItems)
            {
                var title = item.Value<string>("title");
                if (string.IsNullOrWhiteSpace(title))
                {
                    title = item.Name;
                }

                var summary = item.Value<string>("summary");
                var image = item.Value<MediaWithCrops>("coverImage");

                <a class="news-card" href="@item.Url()">
                    @if (image != null)
                    {
                        <img src="@image.MediaUrl()" alt="@title" />
                    }

                    <div class="news-card-content">
                        <h2>@title</h2>

                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p>@summary</p>
                        }
                    </div>
                </a>
            }
        </section>
    </main>

    <script src="/js/sama.js"></script>
</body>
</html>